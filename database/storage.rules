rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isImage() { return request.resource.contentType.matches('image/.*') && request.resource.size < 5 * 1024 * 1024; }

    // Fotos de perfil: lectura para usuarios autenticados, escritura solo del dueño.
    match /profiles/{uid}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid && isImage();
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Selfie de verificación: el dueño la sube; solo administradores la leen.
    match /verification/{uid}/{file} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if request.auth != null && request.auth.uid == uid && isImage();
    }
  }
}
