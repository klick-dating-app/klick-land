require_relative '../../web/node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '14.0'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../web/node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../web/node_modules/@capacitor/ios'
  pod 'CapacitorApp', :path => '../../web/node_modules/@capacitor/app'
  pod 'CapacitorBrowser', :path => '../../web/node_modules/@capacitor/browser'
  pod 'CapacitorCamera', :path => '../../web/node_modules/@capacitor/camera'
  pod 'CapacitorGeolocation', :path => '../../web/node_modules/@capacitor/geolocation'
  pod 'CapacitorHaptics', :path => '../../web/node_modules/@capacitor/haptics'
  pod 'CapacitorKeyboard', :path => '../../web/node_modules/@capacitor/keyboard'
  pod 'CapacitorPushNotifications', :path => '../../web/node_modules/@capacitor/push-notifications'
  pod 'CapacitorSplashScreen', :path => '../../web/node_modules/@capacitor/splash-screen'
  pod 'CapacitorStatusBar', :path => '../../web/node_modules/@capacitor/status-bar'
end

target 'App' do
  capacitor_pods
  # Push: Capacitor entrega el token FCM (no el de APNs) para que Cloud Functions pueda notificar.
  pod 'FirebaseMessaging'
end

post_install do |installer|
  assertDeploymentTarget(installer)
end
