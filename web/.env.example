# =============================================================================
# KLICK! — VARIABLES DE ENTORNO (TEMPLATE DE EJEMPLO)
# Copia este archivo a .env.local y completa los valores correspondientes.
# =============================================================================

# --- ENTORNO GENERAL ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="KLICK!"

# --- FIREBASE CLIENT (Navegador / App Web & Móvil) ---
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy_YOUR_FIREBASE_CLIENT_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=klick-safemeet.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=klick-safemeet
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=klick-safemeet.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# --- GOOGLE ANALYTICS 4 ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- FIREBASE ADMIN SDK (Servidor: Cloud Functions / API Routes) ---
FIREBASE_PROJECT_ID=klick-safemeet
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@klick-safemeet.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_RSA_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- STRIPE BILLING & SUSCRIPCIONES (Fase 1: Pagos FIAT) ---
# Claves obtenidas en Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_51PXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51PXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# URLs de retorno de Stripe Checkout
NEXT_PUBLIC_STRIPE_SUCCESS_URL=http://localhost:3000/portal?subscription=success
NEXT_PUBLIC_STRIPE_CANCEL_URL=http://localhost:3000/portal?subscription=cancelled

# --- GOOGLE CLOUD & VERTEX AI (Moderación de Contenido & Asistente) ---
GOOGLE_CLOUD_PROJECT=klick-safemeet
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_AI_ENDPOINT=us-central1-aiplatform.googleapis.com

# --- WEB3 SOLANA (Fase 2: Identidad & Pagos On-Chain) ---
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# RPC Dedicado de Alta Velocidad (Helius / Triton)
# NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
NEXT_PUBLIC_TREASURY_WALLET=YOUR_SOLANA_TREASURY_PUBLIC_KEY
NEXT_PUBLIC_KLICK_PROGRAM_ID=YOUR_ANCHOR_PROGRAM_ID
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# --- PROVEEDOR KYC / VERIFICACIÓN DE IDENTIDAD ---
KYC_PROVIDER_API_KEY=your_kyc_provider_key_here
KYC_PROVIDER_SECRET=your_kyc_provider_secret_here

# --- META PIXEL / CAPI (Marketing) ---
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
